<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="MauiAppTempoAgora.MainPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    Title="Previsão do Tempo"
    BackgroundColor="CornflowerBlue"
    Shell.NavBarIsVisible="False">

    <ScrollView>
        <VerticalStackLayout Padding="30,0" Spacing="10">

            <Button Text="Minha Localização" 
                    Padding="10" 
                    Margin="5, 10, 1, 1" 
                    Clicked="Button_Clicked_Localizacao" />

            <Label x:Name="lbl_coords" 
                    Margin="0,0,0,10" />

            <Entry x:Name="txt_cidade"
                   FontAttributes="Bold"
                   PlaceholderColor="NavajoWhite"
                   TextColor="DarkBlue"
                   Margin="0, 10, 5, 5" />

            <Button Text="Buscar Previsão"
                    Padding="5.0"
                    Margin="0, 5, 1, 1"
                    Clicked="Button_Clicked_Previsao" />

            <Label x:Name="lbl_res"
                   FontAttributes="Bold"
                   TextColor="DarkBlue"
                   Margin="0, 5, 1, 1" />

            <WebView x:Name="wv_mapa" HeightRequest="180" />

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
